{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "git-remote-gitopia",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/git-remote-gitopia",
      "buildFlags": "--tags prod",
      "cwd": "${workspaceFolder}",
      "args": ["origin", "gitopia://user/repo"],
      "env": {
        "GIT_DIR": "${workspaceFolder}/.git",
        "GITOPIA_WALLET": "wallet.json"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "git-credential-gitopia",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/git-credential-gitopia",
      "buildFlags": "--tags prod",
      "cwd": "${workspaceFolder}",
      "args": ["get"],
      "env": {
        "GIT_DIR": "${workspaceFolder}/.git",
        "GITOPIA_WALLET": "wallet.json"
      },
      "console": "integratedTerminal"
    }
  ]
}
